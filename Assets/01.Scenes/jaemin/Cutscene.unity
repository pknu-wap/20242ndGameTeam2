  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bd36c5ed70d2c954ca7bdb4e15671d3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cutsceneImage: {fileID: 766900282}
  narrationText: {fileID: 2077846967}
  fadePanel: {fileID: 668763311}
  cutscenes:
  - image: {fileID: 21300000, guid: d105bce8de18bf645b41748d4173087d, type: 3}
    texts:
    - "\uCE58\uC5F4\uD55C \uC804\uD22C\uAC00 \uB05D\uB098\uACE0 \uC801\uB9C9\uB9CC\uC774
      \uC874\uC7AC\uD588\uB2E4."
    - "\uC804\uC7A5\uC740 \uD63C\uB3C8\uACFC \uC8FD\uC74C\uC73C\uB85C \uBB3C\uB4E4\uC5B4
      \uC788\uC5C8\uACE0 \uC0B4\uC544\uB0A8\uC740 \uC790\uB294 \uC5C6\uC5C8\uB2E4.
      \uB2E8 \uD55C \uBA85\uC744 \uC81C\uC678\uD558\uACE0\uB294..."
  - image: {fileID: 21300000, guid: ab1fbcae06da2d746b112e63398deb79, type: 3}
    texts:
    - "\uADF8\uB294 \uC77C\uC0DD \uB300\uBD80\uBD84\uC744 \uC6A9\uBCD1\uB2E8\uC5D0
      \uBC14\uCE5C \uAC15\uB825\uD55C \uC804\uC0AC\uC600\uB2E4."
    - "\uADF8\uB294 \uC218\uB9CE\uC740 \uC804\uC7A5\uC5D0\uC11C \uC0B4\uC544\uB0A8\uC558\uACE0
      \uC5B4\uB5A0\uD55C \uC801\uB3C4 \uADF8\uC758 \uC0C1\uB300\uAC00 \uB418\uC9C0
      \uC54A\uC558\uB2E4."
  - image: {fileID: 21300000, guid: 1ee0568b59f97114db80a71d1c94be30, type: 3}
    texts:
    - "\uC774\uBC88 \uC804\uD22C\uB3C4 \uADF8\uB97C \uC8FD\uC774\uC9C0 \uBABB\uD558\uC600\uACE0,
      \uADF8\uB294 \uB610 \uC0B4\uC544\uB0A8\uC558\uB2E4."
    - "\uC804\uC7C1\uC774 \uB05D\uB098 \uB3CC\uC544\uAC08\uB824\uB358 \uCC30\uB098,
      \uC548\uC2EC\uD558\uACE0 \uC788\uB358 \uADF8\uC758 \uB4B7\uD3B8\uC5D0\uC11C
      \uBB34\uC5C7\uC778\uAC00 \uC77C\uC5B4\uB098\uACE0 \uC788\uC5C8\uB2E4."
    - "\uC804\uD22C\uC758 \uC5EC\uD30C\uB85C \uC9C0\uCCD0\uC11C\uC778\uC9C0, \uADF8\uB294
      \uC778\uC9C0\uC870\uCC28 \uD558\uC9C0 \uBABB\uD558\uACE0 \uC788\uC5C8\uB2E4."
  - image: {fileID: 21300000, guid: e2577366fbc32cd42b644ebacb2e81be, type: 3}
    texts:
    - "\uB208 \uAE5C\uBE61\uD560 \uC0AC\uC774\uC5D0 \uC815\uCCB4 \uBD88\uBA85\uC758
      \uBB34\uC5B8\uAC00\uAC00 \uADF8\uB97C \uACF5\uACA9\uD588\uACE0, \uADF8\uB294
      \uBC18\uC751\uC870\uCC28 \uD558\uC9C0 \uBABB\uD588\uB2E4."
    - "\uADF8\uB294 \uC21C\uC2DD\uAC04\uC5D0 \uC815\uC2E0\uC744 \uC783\uC5C8\uB2E4...................."
  - image: {fileID: 21300000, guid: 96c8d4b915bb459439a80bc7ffd5e69d, type: 3}
    texts:
    - "\uC815\uC2E0\uC744 \uCC28\uB9AC\uB2C8 \uADF8\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uB294 \uD669\uBB34\uC9C0\uC5D0 \uBC84\uB824\uC9C4 \uC0C1\uD0DC\uC600\uB2E4."
    - "\uADF8\uB294 \uCC28\uAC11\uAC8C \uC2DD\uC5B4\uAC00\uB294 \uC790\uC2E0\uC758
      \uBAB8\uC744 \uB290\uB07C\uBA70 \uC8FD\uC74C\uC744 \uC9C1\uAC10\uD588\uB2E4."
    - "\uC65C \uC774\uB807\uAC8C \uB418\uC5C8\uB294\uC9C0 \uB2F9\uD669\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC,
      \uC6D0\uC778\uC744 \uC54C\uC544\uB0BC \uD2C8\uB3C4 \uC5C6\uC774 \uC810\uC810
      \uB208\uC774 \uAC10\uACA8\uC654\uB2E4......"
  - image: {fileID: 21300000, guid: 0cd7d4db85b131c4692bb06ac783c173, type: 3}
    texts:
    - "\"\uC774\uB300\uB85C \uB05D\uC778\uAC00....\uD5C8\uBB34\uD55C \uC778\uC0DD\uC774\uAD70.\""
    - "\uD56D\uC0C1 \uD3C9\uD654\uB85C\uC6B4 \uC0DD\uD65C\uC744 \uAFC8\uAFD4\uC628
      \uADF8\uC600\uC9C0\uB9CC, \uACB0\uAD6D \uADF8 \uAFC8\uC740 \uC774\uB8E8\uC5B4\uC9C8
      \uC218 \uC5C6\uC5C8\uB2E4."
    - "\uADF8\uB807\uAC8C \uBAA8\uB4E0\uAC8C \uB05D\uC774\uB77C\uACE0 \uC0DD\uAC01\uD588\uB358
      \uADF8 \uC21C\uAC04, \uC5B4\uB514\uC120\uAC00 \uB530\uC2A4\uD55C \uBC14\uB78C\uC774
      \uBD88\uC5B4\uC654\uB2E4."
    - "\"......\uBB50\uC9C0?\""
  - image: {fileID: 21300000, guid: 4b8da6e3f73245149ab14aab13639b7b, type: 3}
    texts:
    - "\uB208\uC744 \uB728\uB2C8 \uADF8\uC758 \uB208 \uC55E\uC5D0\uB294 \uC544\uB9AC\uB530\uC6B4
      \uC5EC\uC131\uC774 \uC790\uC560\uB85C\uC6B4 \uD45C\uC815\uC73C\uB85C \uADF8\uB97C
      \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    - "\"\uB2F9\uC2E0\uC758 \uC6A9\uB9F9\uD568\uC774 \uD558\uB298\uC5D0 \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4.\""
    - "\"\uC624\uB518\uAED8\uC11C \uB2F9\uC2E0\uC744 \uBC1C\uD560\uB77C\uB85C \uCD08\uB300\uD558\uACE0
      \uC2F6\uC5B4 \uD558\uC2ED\uB2C8\uB2E4.\""
    - "\uADF8\uB294 \uB300\uB2F5\uD558\uB824 \uD588\uC73C\uB098 \uBAA9\uC18C\uB9AC\uAC00
      \uB098\uC624\uC9C0 \uC54A\uC558\uB2E4."
  - image: {fileID: 21300000, guid: 180b0683b16b5ad4aa46f117c00b3381, type: 3}
    texts:
    - "\"\uC790 \uBC1C\uD0A4\uB9AC\uB4E4\uC774\uC5EC \uC774 \uC6A9\uB9F9\uD55C \uC804\uC0AC\uB97C
      \uBC1C\uD560\uB77C\uB85C \uC778\uB3C4\uD574 \uC8FC\uC138\uC694.\""
    - "\uADF8\uB140\uC758 \uB9D0\uACFC \uB3D9\uC2DC\uC5D0 \uD558\uB298\uC5D0\uC11C
      \uBC1C\uD0A4\uB9AC 2\uBA85\uC774 \uB0B4\uB824\uC640 \uADF8\uB97C \uD558\uB298\uB85C
      \uB370\uB9AC\uACE0 \uB0A0\uC544\uAC14\uB2E4."
  - image: {fileID: 21300000, guid: d23ca6ccccc14d44bac19ab9d47f37ce, type: 3}
    texts:
    - "\uC7A0\uC2DC \uC815\uC2E0\uC744 \uC783\uACE0 \uC77C\uC5B4\uB098\uBCF4\uB2C8
      \uADF8\uB294 \uD63C\uC790 \uB369\uADF8\uB7EC\uB2C8 \uC81C\uB2E8\uC704\uC5D0
      \uB204\uC6CC\uC788\uC5C8\uB2E4."
    - "\uADF8\uB807\uAC8C \uADF8\uB294 \uBC1C\uD560\uB77C\uC5D0 \uC624\uAC8C \uB418\uC5C8\uB2E4..."
  fadeDuration: 2
  textSpeed: 0.1
  waitBetweenTexts: 3
